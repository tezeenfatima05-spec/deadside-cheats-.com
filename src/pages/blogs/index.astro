---
import BaseLayout from '../../layouts/BaseLayout.astro';
import {
  blogPosts,
  getBlogTags,
  getFeaturedBlogPost,
  getNonFeaturedBlogPosts,
} from '../../data/blog';
import { t } from '../../i18n';
import { resolvePageSeo } from '../../config/seo';
import { breadcrumbSchema, collectionPageSchema } from '../../utils/schema';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import BlogCard from '../../components/BlogCard.astro';
import BlogSortSelect from '../../components/BlogSortSelect.astro';
import Icon from '../../components/icons/Icon.astro';
import { blogTagIcons } from '../../data/sectionIcons';
import type { IconName } from '../../components/icons/types';
import { Button } from '@/components/starwind/button';
import { ROUTES } from '../../utils/path';

const seo = resolvePageSeo('/blogs/');
const breadcrumbs = [
  { name: 'Home', path: '/' },
  { name: 'Blogs', path: '/blogs/' },
];

const featured = getFeaturedBlogPost();
const gridPosts = getNonFeaturedBlogPosts();
const tags = getBlogTags();
const allGridPosts = featured ? [featured, ...gridPosts] : gridPosts;
const tagIcon = (tag: string): IconName => blogTagIcons[tag] ?? 'tag';
const emptyMessage = t.blog.emptyFilter;
---

<BaseLayout
  title={seo.title}
  description={seo.description}
  jsonLd={[
    collectionPageSchema({
      name: t.blog.title,
      description: t.blog.subtitle,
      url: '/blogs/',
    }),
    breadcrumbSchema(breadcrumbs),
  ]}
>
  <section class="py-8 md:py-12">
    <div class="mx-auto max-w-6xl px-5">
      <Breadcrumbs items={breadcrumbs} />
      <header class="section-header mt-8 max-w-2xl">
        <p class="section-header__eyebrow">{t.blog.eyebrow}</p>
        <h1 id="blog-latest-title" class="section-header__title">{t.blog.latestTitle}</h1>
        <p class="section-header__subtitle">{t.blog.latestSubtitle}</p>
      </header>
    </div>
  </section>

  <section
    class="border-y border-border bg-muted/20 py-12 md:py-16"
    aria-labelledby="blog-latest-title"
    data-blog-index
    data-empty-message={emptyMessage}
  >
    <div class="mx-auto max-w-6xl px-5">
      <form id="blog-search-form" class="max-w-xl" role="search" action="/blogs/" method="get">
        <label for="blog-search" class="text-xs font-medium uppercase tracking-wider text-muted-foreground">
          {t.blog.searchLabel}
        </label>
        <input
          id="blog-search"
          name="q"
          type="search"
          class="mt-2 w-full rounded-xl border border-border bg-background px-4 py-2.5 text-sm shadow-xs outline-none focus:border-primary"
          placeholder={t.blog.searchPlaceholder}
          autocomplete="off"
        />
      </form>

      <div class="mt-8 flex flex-col gap-4 lg:mt-10 lg:flex-row lg:items-end lg:justify-between lg:gap-6">
        <div
          class="flex gap-2 overflow-x-auto pb-1 [-ms-overflow-style:none] [scrollbar-width:none] [&::-webkit-scrollbar]:hidden"
          role="toolbar"
          aria-label="Filter articles by topic"
        >
          <button
            type="button"
            class="blog-filter inline-flex shrink-0 items-center gap-2 rounded-full border border-border bg-background px-4 py-2 text-sm font-medium shadow-xs hover:bg-muted aria-pressed:border-primary aria-pressed:bg-primary/10"
            data-blog-filter="all"
            aria-pressed="true"
          >
            <span class="flex size-7 items-center justify-center rounded-full bg-muted text-primary" aria-hidden="true">
              <Icon name="navBlog" size={15} />
            </span>
            {t.blog.filterAll}
          </button>
          {
            tags.map((tag) => (
              <button
                type="button"
                class="blog-filter inline-flex shrink-0 items-center gap-2 rounded-full border border-border bg-background px-4 py-2 text-sm font-medium shadow-xs hover:bg-muted aria-pressed:border-primary aria-pressed:bg-primary/10"
                data-blog-filter={tag}
                aria-pressed="false"
              >
                <span
                  class="flex size-7 items-center justify-center rounded-full bg-muted text-primary"
                  aria-hidden="true"
                >
                  <Icon name={tagIcon(tag)} size={15} />
                </span>
                {tag}
              </button>
            ))
          }
        </div>

        <BlogSortSelect />
      </div>

      <div id="blog-grid" class="mt-10 grid gap-8 sm:grid-cols-2 lg:grid-cols-3 lg:gap-x-8 lg:gap-y-10">
        {allGridPosts.map((post, index) => (
          <BlogCard post={post} index={index} eager={index < 3} showDate />
        ))}
      </div>

      <p id="blog-empty" class="mt-10 hidden text-center text-muted-foreground" role="status">
        {emptyMessage}
      </p>

      <div class="mt-12 flex justify-start lg:justify-center">
        <Button as="a" href={ROUTES.home} variant="outline">
          <Icon name="chevronLeft" size={16} />
          Back to home
        </Button>
      </div>
    </div>
  </section>

  <script>
    import { initBlogIndexFilters } from '../../scripts/blog-index.ts';

    const root = document.querySelector('[data-blog-index]');
    const emptyMessage = root?.getAttribute('data-empty-message') ?? 'No articles match this filter.';

    const boot = () => initBlogIndexFilters(emptyMessage);
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', boot);
    } else {
      boot();
    }
  </script>
</BaseLayout>