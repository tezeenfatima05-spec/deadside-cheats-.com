---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import Icon from '../../components/icons/Icon.astro';
import { resolvePageSeo } from '../../config/seo';
import { breadcrumbSchema, collectionPageSchema } from '../../utils/schema';
import {
  getRatingDistribution,
  getReviewAverage,
  siteReviews,
  type SiteReview,
} from '../../data/reviews';
import { Button } from '@/components/starwind/button';
import { ROUTES } from '../../utils/path';

const seo = resolvePageSeo('/reviews/');
const breadcrumbs = [
  { name: 'Home', path: '/' },
  { name: 'Reviews', path: '/reviews/' },
];

const average = getReviewAverage();
const distribution = getRatingDistribution();
const total = siteReviews.length;

function stars(n: number) {
  return '★'.repeat(n) + '☆'.repeat(5 - n);
}
---

<BaseLayout
  title={seo.title}
  description={seo.description}
  jsonLd={[
    collectionPageSchema({ name: 'Deadside Cheats Reviews', description: seo.description, url: '/reviews/' }),
    breadcrumbSchema(breadcrumbs),
  ]}
>
  <section class="py-10 md:py-14" data-reviews-page>
    <div class="mx-auto max-w-6xl px-5">
      <Breadcrumbs items={breadcrumbs} />

      <header class="mt-8 max-w-2xl">
        <p class="text-sm font-semibold uppercase tracking-wider text-primary">Customer feedback</p>
        <h1 class="mt-2 text-3xl font-bold md:text-4xl">Reviews</h1>
        <p class="mt-3 text-muted-foreground">
          Reader-submitted style feedback for Deadside Cheats products. Includes mixed ratings—support replies are shown when the issue came from setup mistakes.
        </p>
      </header>

      <div class="mt-10 grid gap-8 rounded-2xl border border-border bg-card p-6 md:grid-cols-[14rem_1fr] md:p-8">
        <div class="text-center md:text-left">
          <p class="font-[family-name:var(--font-heading)] text-5xl font-bold text-primary">{average.toFixed(1)}</p>
          <p class="mt-1 text-lg tracking-wide text-amber-400" aria-label={`${average.toFixed(1)} out of 5`}>{stars(Math.round(average))}</p>
          <p class="mt-2 text-sm text-muted-foreground">{total} reviews</p>
        </div>
        <div class="space-y-2">
          {
            ([5, 4, 3, 2, 1] as const).map((rating) => {
              const count = distribution[rating];
              const pct = total ? Math.round((count / total) * 100) : 0;
              return (
                <div class="flex items-center gap-3 text-sm">
                  <span class="w-12 shrink-0 tabular-nums">{rating}★</span>
                  <div class="h-2 flex-1 overflow-hidden rounded-full bg-muted">
                    <div class="h-full rounded-full bg-primary" style={`width:${pct}%`} />
                  </div>
                  <span class="w-10 shrink-0 text-right tabular-nums text-muted-foreground">{count}</span>
                </div>
              );
            })
          }
        </div>
      </div>

      <div class="mt-8 flex flex-col gap-4 lg:flex-row lg:items-end lg:justify-between">
        <div class="flex flex-wrap gap-2" role="toolbar" aria-label="Filter by rating">
          <button type="button" class="rounded-full border border-border bg-background px-4 py-2 text-sm aria-pressed:border-primary aria-pressed:bg-primary/10" data-review-filter="all" aria-pressed="true">Show all ratings</button>
          {
            ([5, 4, 3, 2, 1] as const).map((rating) => (
              <button
                type="button"
                class="rounded-full border border-border bg-background px-4 py-2 text-sm aria-pressed:border-primary aria-pressed:bg-primary/10"
                data-review-filter={String(rating)}
                aria-pressed="false"
              >
                {rating}★
              </button>
            ))
          }
        </div>
        <label class="block max-w-xs text-sm">
          <span class="text-xs font-medium uppercase tracking-wider text-muted-foreground">Search</span>
          <input
            id="review-search"
            type="search"
            class="mt-1 w-full rounded-xl border border-border bg-background px-3 py-2"
            placeholder="Search reviews…"
            autocomplete="off"
          />
        </label>
      </div>

      <ul id="review-list" class="mt-10 space-y-5">
        {
          siteReviews.map((review: SiteReview) => (
            <li
              class="rounded-2xl border border-border bg-card p-5 md:p-6"
              data-review-card
              data-rating={review.rating}
              data-search={`${review.title} ${review.body} ${review.author} ${review.product}`.toLowerCase()}
            >
              <div class="flex flex-wrap items-start justify-between gap-3">
                <div>
                  <p class="font-semibold">{review.author} <span class="text-xs font-normal text-muted-foreground">· {review.region}</span></p>
                  <p class="text-sm text-muted-foreground">{review.product} · {review.date}{review.verified ? ' · Verified purchase' : ''}</p>
                </div>
                <p class="text-amber-400" aria-label={`${review.rating} stars`}>{stars(review.rating)}</p>
              </div>
              <h2 class="mt-3 text-lg font-semibold">{review.title}</h2>
              <p class="mt-2 text-sm leading-relaxed text-muted-foreground">{review.body}</p>
              {
                review.replies?.length ? (
                  <div class="mt-4 space-y-3 border-t border-border pt-4">
                    {review.replies.map((reply) => (
                      <div class:list={['rounded-xl px-4 py-3 text-sm', reply.role === 'support' ? 'bg-primary/10' : 'bg-muted/40']}>
                        <p class="font-medium">
                          {reply.author}
                          {reply.role === 'support' ? ' · Support' : ''}
                          <span class="ml-2 text-xs font-normal text-muted-foreground">{reply.date}</span>
                        </p>
                        <p class="mt-1 text-muted-foreground">{reply.body}</p>
                      </div>
                    ))}
                  </div>
                ) : null
              }
            </li>
          ))
        }
      </ul>

      <p id="review-empty" class="mt-8 hidden text-center text-muted-foreground" role="status">No reviews match your filters.</p>

      <div class="mt-12 flex justify-center gap-3">
        <Button as="a" href={ROUTES.products} variant="primary">View products</Button>
        <Button as="a" href={ROUTES.support} variant="outline">Get support</Button>
      </div>
    </div>
  </section>

  <script>
    const filters = document.querySelectorAll<HTMLButtonElement>('[data-review-filter]');
    const cards = [...document.querySelectorAll<HTMLElement>('[data-review-card]')];
    const search = document.getElementById('review-search') as HTMLInputElement | null;
    const empty = document.getElementById('review-empty');

    const active = () =>
      document.querySelector<HTMLButtonElement>('[data-review-filter][aria-pressed="true"]')?.dataset.reviewFilter ?? 'all';

    const apply = () => {
      const rating = active();
      const q = (search?.value ?? '').trim().toLowerCase();
      let visible = 0;
      cards.forEach((card) => {
        const ratingMatch = rating === 'all' || card.dataset.rating === rating;
        const searchMatch = !q || (card.dataset.search ?? '').includes(q);
        const show = ratingMatch && searchMatch;
        card.classList.toggle('hidden', !show);
        if (show) visible += 1;
      });
      empty?.classList.toggle('hidden', visible > 0);
    };

    filters.forEach((btn) => {
      btn.addEventListener('click', () => {
        filters.forEach((b) => b.setAttribute('aria-pressed', 'false'));
        btn.setAttribute('aria-pressed', 'true');
        apply();
      });
    });
    search?.addEventListener('input', apply);
  </script>
</BaseLayout>